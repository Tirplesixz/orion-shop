# Change this before exposing the admin dashboard outside your computer.
ORION_ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/orion_shop?schema=public
SESSION_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://127.0.0.1:5173

# Mini-project commerce defaults.
STORE_TAX_RATE=0.07
STORE_SHIPPING_FEE=120

# Optional SMTP delivery. Leave empty to log email previews locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ORION <orders@example.com>

# Leave empty when the React app and included API share the same origin.
VITE_API_BASE_URL=
