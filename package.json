    "express-rate-limit": "^8.7.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "prisma": "^7.10.1",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
