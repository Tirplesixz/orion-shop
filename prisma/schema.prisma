generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  REVIEW
  PAID
  REFUNDED
  FAILED
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
  RETURNED
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum MovementType {
  INITIAL
  MANUAL
  SALE
  CANCEL_RESTORE
  RETURN_RESTORE
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AdminUser {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("owner")
  active       Boolean    @default(true)
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Customer {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String
  phone        String?
  passwordHash String?
  emailVerifiedAt DateTime?
  preferredLanguage String    @default("en")
  deletedAt    DateTime?
  sessions     Session[]
  accountTokens AccountToken[]
  addresses    Address[]
  orders       Order[]
  returns      ReturnRequest[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Session {
  id         String     @id @default(uuid())
  tokenHash  String     @unique
  adminId    String?
  customerId String?
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model AccountToken {
  id         String           @id @default(uuid())
  tokenHash  String           @unique
  type       AccountTokenType
  customerId String
  expiresAt  DateTime
  usedAt     DateTime?
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  @@index([customerId, type])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  label      String   @default("Shipping")
  recipient  String
  phone      String
  address    String
  city       String
  province   String?
  postalCode String
  country    String   @default("Thailand")
  isDefault  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id            String        @id
  slug          String        @unique
  collection    String
  name          String
  nameTh        String        @default("")
  eyebrow       String
  description   String
  descriptionTh String        @default("")
  materialTh    String        @default("")
  careTh        String        @default("")
  fitTh         String        @default("")
  category      String        @default("Outerwear")
  categoryTh    String        @default("เสื้อคลุม")
  sortOrder     Int           @default(0)
  weightGrams   Int           @default(0)
  fulfillmentType String      @default("ready")
  theme         Json
  campaignImage Json
  images        Json
  price         Decimal?      @db.Decimal(12, 2)
  currency      String        @default("THB")
  priceLabel    String
  material      String        @default("")
  care          String        @default("")
  fit           String        @default("")
  sizeGuide     Json?
  status        ProductStatus @default(DRAFT)
  variants      Variant[]
  orderItems    OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Variant {
  id         String      @id @default(uuid())
  productId  String
  code       String
  label      String
  color      String      @default("")
  colorTh    String      @default("")
  colorHex   String      @default("#111111")
  images     Json?
  barcode    String?     @unique
  available  Boolean     @default(true)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]
  reservations StockReservation[]
  @@unique([productId, code])
}

model Inventory {
  id                String          @id @default(uuid())
  variantId         String          @unique
  sku               String          @unique
  stock             Int             @default(0)
  reserved          Int             @default(0)
  unitCost          Decimal?        @db.Decimal(12, 2)
  lowStockThreshold Int             @default(2)
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements         StockMovement[]
  updatedAt         DateTime        @updatedAt
}

model StockMovement {
  id          String       @id @default(uuid())
  inventoryId String
  type        MovementType
  quantity    Int
  balance     Int
  reference   String?
  note        String?
  inventory   Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  @@index([inventoryId, createdAt])
}

model StockReservation {
  id         String   @id @default(uuid())
  variantId  String
  sessionKey String
  quantity   Int
  status     String   @default("active")
  expiresAt  DateTime
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([sessionKey, status])
  @@index([expiresAt, status])
}

model Order {
  id                 String          @id @default(uuid())
  orderNumber        String          @unique
  customerId         String
  status             OrderStatus     @default(NEW)
  paymentStatus      PaymentStatus   @default(UNPAID)
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingAddress    String
  shippingCity       String
  shippingProvince   String?
  shippingPostalCode String
  shippingCountry    String          @default("Thailand")
  shippingMethodCode String          @default("standard")
  shippingMethodName String          @default("Standard delivery")
  invoiceRequested   Boolean         @default(false)
  invoiceNumber      String?
  taxId              String?
  companyName        String?
  billingAddress     String?
  note               String?
  currency           String          @default("THB")
  subtotal           Decimal         @db.Decimal(12, 2)
  discount           Decimal         @default(0) @db.Decimal(12, 2)
  shippingFee        Decimal         @default(0) @db.Decimal(12, 2)
  tax                Decimal         @default(0) @db.Decimal(12, 2)
  total               Decimal         @db.Decimal(12, 2)
  hasPriceOnRequest   Boolean         @default(false)
  couponCode          String?
  customer            Customer        @relation(fields: [customerId], references: [id])
  items               OrderItem[]
  timeline            OrderTimeline[]
  payments            Payment[]
  shipment            Shipment?
  returns             ReturnRequest[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id           String       @id @default(uuid())
  orderId      String
  productId    String
  variantId    String
  productName  String
  productSlug  String
  image        String
  variantLabel String
  quantity     Int
  unitPrice    Decimal?     @db.Decimal(12, 2)
  lineTotal    Decimal?     @db.Decimal(12, 2)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  variant      Variant      @relation(fields: [variantId], references: [id])
  returnItems  ReturnItem[]
}

model OrderTimeline {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  provider    String        @default("sandbox")
  providerRef String        @unique
  status      PaymentStatus @default(UNPAID)
  amount      Decimal       @db.Decimal(12, 2)
  metadata    Json?
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String         @unique
  carrier        String         @default("Manual")
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(12, 2)
  minSubtotal Decimal    @default(0) @db.Decimal(12, 2)
  usageLimit  Int?
  usedCount   Int        @default(0)
  active      Boolean    @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ReturnRequest {
  id         String       @id @default(uuid())
  orderId    String
  customerId String
  reason     String
  status     ReturnStatus @default(REQUESTED)
  note       String?
  order      Order        @relation(fields: [orderId], references: [id])
  customer   Customer     @relation(fields: [customerId], references: [id])
  items      ReturnItem[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
}

model AuditLog {
  id        String     @id @default(uuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  @@index([createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  name       String
  sessionKey String?
  customerId String?
  path       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([name, createdAt])
}

model ShippingMethod {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  nameTh        String
  description   String   @default("")
  descriptionTh String   @default("")
  fee           Decimal  @db.Decimal(12, 2)
  freeAbove     Decimal? @db.Decimal(12, 2)
  provinceGroup String   @default("all")
  estimatedDays String   @default("2–4 business days")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
